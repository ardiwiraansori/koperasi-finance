APP_NAME="Koperasi Mutiara Tigo Pasie"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://koperasi-finance.test
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=koperasi_demo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Akun admin awal (dipakai oleh db:seed). Isi sandi kuat, lalu hapus baris ini setelah seeding.
ADMIN_EMAIL=admin@koperasi.test
ADMIN_PASSWORD=

# Percayai header proxy hanya bila memang di belakang proxy (Render/Cloudflare): TRUSTED_PROXIES=*
# Di hosting biasa biarkan kosong, agar batas percobaan login tidak bisa dipalsukan.
TRUSTED_PROXIES=
